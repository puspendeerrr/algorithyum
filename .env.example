# EmailJS Configuration (Next.js Public Client Environment Variables)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_djfthkb
NEXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=template_af14tdf
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Backwards Compatibility (Optional)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=template_djfthkb
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
